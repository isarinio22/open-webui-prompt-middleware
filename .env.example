# --- Middleware ---
# Real OpenAI key. Only the middleware container ever sees it.
OPENAI_API_KEY=sk-replace-me
# Where chat completions are forwarded. Override to point at a mock or a proxy.
OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated list advertised by GET /v1/models.
ALLOWED_MODELS=gpt-4o-mini,gpt-4o
# Path inside the container; the Dockerfile copies the repo's SYSTEM_PROMPT.md here.
SYSTEM_PROMPT_PATH=/app/SYSTEM_PROMPT.md
# Optional. If set, Open WebUI must send it as a Bearer token; leave empty to disable.
MIDDLEWARE_API_KEY=
# Also inject the system prompt into Open WebUI's background title and tag calls.
INJECT_ON_INTERNAL_TASKS=false
# Seconds to establish a TCP connection to OpenAI.
UPSTREAM_CONNECT_TIMEOUT=10
# Seconds to wait for a response, or between streamed chunks.
UPSTREAM_READ_TIMEOUT=60
# Extra attempts after a connection error, timeout or 5xx. Never once bytes reach the client.
UPSTREAM_MAX_RETRIES=2
# Python logging level for the middleware's JSON logs.
LOG_LEVEL=INFO
# Log full chat messages. Off by default because they may contain personal data.
LOG_MESSAGE_CONTENT=false

# --- Postgres (Open WebUI persistence) ---
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=openwebui
POSTGRES_DB=openwebui

# --- Open WebUI ---
# Signs Open WebUI session tokens. Change it for anything beyond local use.
WEBUI_SECRET_KEY=change-me
